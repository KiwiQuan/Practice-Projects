DROP TABLE patients;

CREATE TABLE IF NOT EXISTS patients(
patient_id VARCHAR(100) PRIMARY KEY,
date DATE,
name VARCHAR(100),
age INTEGER,
weight INTEGER,
gender VARCHAR(100),
location VARCHAR(100),
phone_number INTEGER,
disease VARCHAR(100),
doctor_name VARCHAR(100),
doctor_id INTEGER
)

